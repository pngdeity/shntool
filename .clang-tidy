---
# Static-analysis gate. clang-tidy reads build/compile_commands.json generated
# by Meson; run it with:
#   run-clang-tidy -p build
#
# The Deep analyzer (clang-analyzer-*) finds memory and undefined-behavior
# defects, and the tree is clean against it. Core, security and unix findings
# are fatal. Style-heavy check families (bugprone-macro-parentheses,
# cert-dcl37-c header guards, misc-include-cleaner, ...) are intentionally not
# enabled: they flag long-standing upstream idioms without indicating defects,
# so adopting them would add churn unrelated to this modernization.
#
# InsecureAPI.DeprecatedOrUnsafeBufferHandling demands the optional C11 Annex K
# "_s" functions, which glibc does not provide; it is disabled rather than
# reaching for a non-portable replacement.
Checks: >
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-deadcode.*
WarningsAsErrors: >
  clang-analyzer-core.*,
  clang-analyzer-security.*,
  clang-analyzer-unix.*
HeaderFilterRegex: '.*\.(c|h)$'
FormatStyle: file
