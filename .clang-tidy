---
# Focused static-analysis checks. clang-tidy reads build/compile_commands.json
# generated by Meson; run it with:
#   run-clang-tidy -p build
Checks: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  misc-*,
  performance-*,
  portability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -misc-no-recursion
WarningsAsErrors: >
  clang-analyzer-core.*,
  clang-analyzer-security.*,
  clang-analyzer-unix.*
HeaderFilterRegex: '.*\.(c|h)$'
FormatStyle: file
