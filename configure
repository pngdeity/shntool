#!/bin/sh
# Compatibility wrapper that emulates the subset of shntool's historical
# ./configure interface used by downstream packagers, then invokes Meson.
set -eu

builddir="build"
prefix="/usr/local"
meson_args=""

for arg in "$@"; do
  case "$arg" in
    --prefix=*)       prefix="${arg#*=}" ;;
    --with-modes=*)   meson_args="$meson_args -Dmodes=${arg#*=}" ;;
    --with-formats=*) meson_args="$meson_args -Dformats=${arg#*=}" ;;
    --build=*|--host=*|--target=*|--libdir=*|--mandir=*|--bindir=*) : ;;
    -h|--help)
      printf '%s\n' "Usage: ./configure [--prefix=DIR] [--with-modes=LIST] [--with-formats=LIST]"
      exit 0
      ;;
    *) printf '%s\n' "configure: warning: ignoring unsupported option: $arg" >&2 ;;
  esac
done

# shellcheck disable=SC2086
exec meson setup "$builddir" --prefix="$prefix" $meson_args
